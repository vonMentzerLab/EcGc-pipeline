############################################################
# INPUTS
############################################################
samples_tsv: config/samples.tsv

# Working directory where the pipeline will create symlinks named <sample>.fa.gz
# (This is NOT where your original genomes must live; those paths go in samples.tsv)
genome_link_dir: work/genomes

############################################################
# REFERENCES
############################################################
cf_reference_nt_db: references/baktamod_CFs_and_kappa_reference_db.fasta
cf_reference_aa_db: references/baktamod_CFs_and_kappa_reference_db_translated.fasta
cf_reference_dmnd: references/baktamod_CFs_and_kappa_reference_db_translated.dmnd
cf_rules_table: references/cf_and_kappa_rules.tsv
cf_lookup_table: references/cf_and_kappa_name_lookup.tsv
bakta_db: /path/to/bakta_db

############################################################
# TOOLS
############################################################
tools:
  rscript: ""
  diamond: ""


############################################################
# OUTPUT ROOTS
############################################################
bakta_outdir: results/bakta
cds_features_outdir: results/cds_features
cf_classification_outdir: results/cf_classification
tmp_dir: results/tmp

############################################################
# THREADS / PARALLELISM
############################################################
bakta_threads: 8
classification_threads: 8
cores: 8

############################################################
# BAKTA PARAMS
############################################################
# if Bakta is not in PATH, you can prepend a PATH here (optional)
bakta_path: ""
bakta_bin: bakta
bakta_genus: Escherichia
bakta_gram: "-"

############################################################
# CF CLASSIFICATION PARAMS
############################################################
min_cov: 80
min_pident: 80
max_dist: 10000
cf_classify_min_score_fraction: 0.95

############################################################
# FASTA EXPORT PARAMS (OPTIONAL)
############################################################
genome_seqs_dir: /work/genomes
fa_suffix: ".fa"   # or ".fa.gz" if that’s what you actually have
output_gene_seqs: false
output_operon_seqs: false